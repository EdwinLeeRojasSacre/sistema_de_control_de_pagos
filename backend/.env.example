DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=sgpe"
# Obligatoria solo para E2E; el nombre de base debe contener _e2e.
DATABASE_URL_E2E="postgresql://USER:PASSWORD@localhost:5432/sgpe_e2e?schema=sgpe"
JWT_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"
NODE_ENV="development"
PORT="3001"
VOUCHER_STORAGE_PATH="./storage/vouchers"

# Observabilidad opcional. Si falta cualquiera de las dos, queda desactivada.
OBSERVE_APP_KEY=""
OBSERVE_APP_SECRET=""
